{
	"name": "@speechify/n8n-nodes-speechify",
	"version": "0.1.0",
	"description": "n8n community node for the Speechify text-to-speech API",
	"license": "MIT",
	"homepage": "https://github.com/speechify-ai/speechify-n8n",
	"keywords": ["n8n-community-node-package"],
	"author": {
		"name": "Speechify",
		"email": "devrel@speechify.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/speechify-ai/speechify-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/speechify-ai/speechify-n8n/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": ["dist"],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": ["dist/credentials/SpeechifyApi.credentials.js"],
		"nodes": ["dist/nodes/Speechify/Speechify.node.js"]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}

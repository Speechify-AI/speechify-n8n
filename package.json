{
	"name": "@speechify/n8n-nodes-speechify",
	"version": "0.0.2",
	"description": "n8n community node for the Speechify text-to-speech API",
	"license": "MIT",
	"homepage": "https://github.com/Speechify-AI/speechify-n8n",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "SpeechifyAI",
		"email": "devrel@speechify.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Speechify-AI/speechify-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/Speechify-AI/speechify-n8n/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SpeechifyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Speechify/Speechify.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
